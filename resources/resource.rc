#include <windows.h>

#define IDI_APP_ICON    101
#define IDR_7ZA_EXE     201
#define IDR_PAYLOAD_7Z  202

// Application Icon
IDI_APP_ICON ICON "app_icon.ico"

// Windows Application Manifest
1 24 "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,2,0,0
PRODUCTVERSION  2,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "UltraArch Studio Team\0"
            VALUE "FileDescription",  "UltraArch Studio Pro - Next-Generation Archive Optimizer\0"
            VALUE "FileVersion",      "2.2.0.0\0"
            VALUE "InternalName",     "UltraArchStudio\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026. All rights reserved.\0"
            VALUE "OriginalFilename", "UltraArchStudio.exe\0"
            VALUE "ProductName",      "UltraArch Studio / Repack Engine Pro\0"
            VALUE "ProductVersion",   "2.2.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

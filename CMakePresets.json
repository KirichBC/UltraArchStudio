{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {"name": "windows", "displayName": "Windows MSVC v143 x64", "generator": "Visual Studio 17 2022", "architecture": "x64", "toolset": "v143", "binaryDir": "${sourceDir}/build/windows", "cacheVariables": {"BUILD_TESTING": "ON", "ULTRAARCH_REQUIRE_TOOLS": "ON"}},
    {"name": "windows-faults", "inherits": "windows", "binaryDir": "${sourceDir}/build/windows-faults", "cacheVariables": {"ULTRAARCH_FAULT_INJECTION": "ON"}},
    {"name": "native", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build/native", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "native-sanitizers", "inherits": "native", "binaryDir": "${sourceDir}/build/native-sanitizers", "cacheVariables": {"ULTRAARCH_SANITIZERS": "ON"}}
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "jobs": 4},
    {"name": "windows-release", "configurePreset": "windows", "configuration": "Release", "jobs": 4},
    {"name": "windows-faults", "configurePreset": "windows-faults", "configuration": "Debug", "jobs": 4},
    {"name": "native", "configurePreset": "native", "jobs": 4},
    {"name": "native-sanitizers", "configurePreset": "native-sanitizers", "jobs": 4}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "windows-release", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "windows-faults", "configurePreset": "windows-faults", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "native", "configurePreset": "native", "output": {"outputOnFailure": true}},
    {"name": "native-sanitizers", "configurePreset": "native-sanitizers", "output": {"outputOnFailure": true}}
  ]
}
